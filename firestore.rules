rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolio_content/{contentId} {
      allow read: if true;
      allow write: if false;
    }

    match /notes/{noteId} {
      allow read: if true;
      allow write: if false;
    }

    match /robotics_projects/{projectId} {
      allow read: if true;
      allow write: if false;
    }

    match /test/connection {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
