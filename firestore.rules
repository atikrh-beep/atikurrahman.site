rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthAdmin() {
      return request.auth != null && (
        request.auth.token.email.matches('(?i).*atik9909@gmail.*') ||
        request.auth.token.email == 'atikurrahman@gmail.com'
      );
    }

    match /portfolio_content/{contentId} {
      allow read: if true;
      allow write: if isAuthAdmin() || request.auth == null;
    }

    match /test/connection {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
